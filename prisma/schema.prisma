// Prisma schema for the modern event planner
// Organize events, share invite links, and track RSVPs — all in one place.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @map("expires") @db.Timestamptz(6)
  sessionToken String   @unique @map("session_token") @db.Text
  accessToken  String?  @unique @map("access_token") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified") @db.Timestamptz(6)
  image         String?
  password      String?
  role          String    @default("user")

  accounts  Account[]
  sessions  Session[]
  events    Event[]
  rsvps     EventRsvp[]

  @@index([email])
  @@map("users")
}

model VerificationToken {
  identifier String      @db.Text
  token      String      @unique @db.Text
  expires    DateTime    @map("expires") @db.Timestamptz(6)

  @@index([identifier, token])
  @@map("verification_tokens")
}

model Event {
  id          String       @id @default(uuid()) @db.Uuid
  ownerUserId String       @map("owner_user_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.Text
  location    String?      @db.VarChar(200)
  eventDate   DateTime?    @map("event_date") @db.Timestamptz(6)
  isPublic    Boolean      @default(true) @map("is_public")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner   User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  invite  EventInvite?
  rsvps   EventRsvp[]

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("events")
}

model EventInvite {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String   @unique @map("event_id") @db.Uuid
  token     String   @unique @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rsvps EventRsvp[]

  @@map("event_invites")
}

model EventRsvp {
  id             String     @id @default(uuid()) @db.Uuid
  eventId        String     @map("event_id") @db.Uuid
  inviteId       String?    @map("invite_id") @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  name           String     @db.VarChar(100)
  email          String     @db.VarChar(200)
  emailNormalized String    @map("email_normalized") @db.VarChar(200)
  status         RsvpStatus
  respondedAt    DateTime   @default(now()) @map("responded_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invite EventInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, emailNormalized])
  @@index([eventId, respondedAt(sort: Desc)])
  @@index([userId])
  @@map("event_rsvps")
}