DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
NEON_AUTH_BASE_URL="https://your-neon-auth-host/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (for login with Google)
# Get these from Google Cloud Console: https://console.cloud.google.com/
NEON_AUTH_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NEON_AUTH_GOOGLE_CLIENT_SECRET="your-google-client-secret"